#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BIN_PATH="$ROOT_DIR/bin/otter-nim"
SRC_PATH="$ROOT_DIR/src/clients/cli/otter_nim.nim"

if [ ! -x "$BIN_PATH" ] || [ "$SRC_PATH" -nt "$BIN_PATH" ]; then
  mkdir -p "$ROOT_DIR/bin"
  nim c -d:release --path:"$ROOT_DIR/src" -o:"$BIN_PATH" "$SRC_PATH"
fi

exec "$BIN_PATH" "$@"
